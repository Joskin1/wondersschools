APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="${MAIL_FROM_ADDRESS}"
MAIL_REPLY_TO_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Lesson Notes Cloud Storage (S3/R2/GCS)
# Leave empty to use default AWS credentials above
LESSON_NOTES_ACCESS_KEY_ID=
LESSON_NOTES_SECRET_ACCESS_KEY=
LESSON_NOTES_REGION=us-east-1
LESSON_NOTES_BUCKET=
LESSON_NOTES_URL=
LESSON_NOTES_ENDPOINT=
LESSON_NOTES_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Multi-Tenancy Configuration
CENTRAL_DOMAINS="wonders.test"
TENANT_DB_HOST="db"
TENANT_DB_PORT="5432"
TENANT_ADMIN_USERNAME="db"
TENANT_ADMIN_PASSWORD="db"
TENANT_DB_PREFIX="tenant_"
TENANT_DEFAULT_ADMIN_NAME="School Admin"
TENANT_DEFAULT_ADMIN_EMAIL="admin@school.com"
SUDO_DOMAIN="wonders.test"
TENANCY_REDIS_BOOTSTRAPPER=false

# Single-Tenant Cloudflare deployment config (e.g. SINGLE_TENANT_ID=chizylite)
# Leave empty for standard domain-based multi-tenancy.
SINGLE_TENANT_ID=
